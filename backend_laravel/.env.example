APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=backend_laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===========================================
# Mail / SMTP configuration
# ===========================================
# Drivers: smtp, sendmail, log, ses, postmark, resend, failover
# For production set MAIL_MAILER=smtp (or failover); use "log" only for local dev.
MAIL_MAILER=smtp
MAIL_HOST=smtp.nikstudio.pro
MAIL_PORT=465
# encryption: ssl (port 465) or tls (port 587)
MAIL_ENCRYPTION=ssl
MAIL_SCHEME=null
MAIL_USERNAME=info@nikstudio.pro
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="info@nikstudio.pro"
MAIL_FROM_NAME="NIK Studio"
# Address that will receive contact-form submissions
MAIL_CONTACT_RECIPIENT="info@nikstudio.pro"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost
SESSION_DOMAIN=localhost

# Frontend URL for Next.js revalidation
FRONTEND_URL=http://localhost:3000
